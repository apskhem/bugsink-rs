{
 "teams": {
  "POST": {
   "id": {
    "type": "string",
    "required": false,
    "read_only": true,
    "label": "Id"
   },
   "name": {
    "type": "string",
    "required": true,
    "read_only": false,
    "label": "Name",
    "max_length": 255
   },
   "visibility": {
    "type": "choice",
    "required": true,
    "read_only": false,
    "label": "Visibility",
    "choices": [
     {
      "value": "joinable",
      "display_name": "joinable"
     },
     {
      "value": "discoverable",
      "display_name": "discoverable"
     },
     {
      "value": "hidden",
      "display_name": "hidden"
     }
    ]
   }
  }
 },
 "projects": {
  "POST": {
   "id": {
    "type": "integer",
    "required": false,
    "read_only": true,
    "label": "ID"
   },
   "team": {
    "type": "field",
    "required": false,
    "read_only": false,
    "label": "Team"
   },
   "name": {
    "type": "string",
    "required": true,
    "read_only": false,
    "label": "Name",
    "max_length": 255
   },
   "slug": {
    "type": "slug",
    "required": true,
    "read_only": false,
    "label": "Slug",
    "max_length": 50
   },
   "dsn": {
    "type": "string",
    "required": false,
    "read_only": true,
    "label": "Dsn"
   },
   "digested_event_count": {
    "type": "integer",
    "required": false,
    "read_only": true,
    "label": "Digested event count"
   },
   "stored_event_count": {
    "type": "integer",
    "required": false,
    "read_only": true,
    "label": "Stored event count"
   },
   "alert_on_new_issue": {
    "type": "boolean",
    "required": false,
    "read_only": false,
    "label": "Alert on new issue"
   },
   "alert_on_regression": {
    "type": "boolean",
    "required": false,
    "read_only": false,
    "label": "Alert on regression"
   },
   "alert_on_unmute": {
    "type": "boolean",
    "required": false,
    "read_only": false,
    "label": "Alert on unmute"
   },
   "visibility": {
    "type": "choice",
    "required": true,
    "read_only": false,
    "label": "Visibility",
    "choices": [
     {
      "value": "joinable",
      "display_name": "joinable"
     },
     {
      "value": "discoverable",
      "display_name": "discoverable"
     },
     {
      "value": "team_members",
      "display_name": "team_members"
     }
    ]
   },
   "retention_max_event_count": {
    "type": "integer",
    "required": false,
    "read_only": false,
    "label": "Retention max event count",
    "min_value": 0,
    "max_value": 2147483647
   },
   "grouping_mechanism": {
    "type": "choice",
    "required": false,
    "read_only": false,
    "label": "Grouping mechanism",
    "choices": [
     {
      "value": "bugsink-v1",
      "display_name": "Original, default until v2.4.0 (July 2026)"
     },
     {
      "value": "bugsink-v2",
      "display_name": "Value-normalized (latest)"
     }
    ]
   }
  }
 },
 "issue-comments": {
  "POST": {
   "id": {
    "type": "integer",
    "required": false,
    "read_only": true,
    "label": "Id"
   },
