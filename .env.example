# Every environment variable bugsink reads. Commented-out lines show the default, or an example where it's unset.
# Leave a variable out rather than setting it to an empty value.
# Names without a BUGSINK_ prefix are upstream Bugsink's settings, with upstream's meaning and defaults.

# --- Database ---
DATABASE_URL=postgres://bugsink:bugsink@localhost:5432/bugsink
# BUGSINK_DB_MAX_CONNECTIONS=20
# Run against a database migrated by a newer upstream Bugsink than this build supports (at your own risk).
BUGSINK_ALLOW_NEWER_UPSTREAM_SCHEMA=false

# --- Server ---
BUGSINK_BIND=127.0.0.1:8000
# Directory with the built frontend.
BUGSINK_STATIC_DIR=frontend/dist
# Background workers (digest, alerts, emails), for both `serve` and `worker`.
BUGSINK_WORKERS=4
# Largest ingest body, compressed and decompressed.
# BUGSINK_MAX_BODY_BYTES=20971520
RUST_LOG=info,sqlx=warn

# --- Site ---
# Where the UI is reachable; links in alerts and DSNs are built from it.
BASE_URL=http://localhost:8000
# SITE_TITLE=Bugsink
# Comma-separated; unset: BASE_URL's host.
# ALLOWED_HOSTS=bugsink.example.org

# --- Behind a reverse proxy ---
# BEHIND_HTTPS_PROXY=false
# BEHIND_PLAIN_HTTP_PROXY=false
# Unset: true behind a proxy, false otherwise.
# USE_X_REAL_IP=true
# USE_X_FORWARDED_FOR=false
# The number of proxies that append to X-Forwarded-For (needed with USE_X_FORWARDED_FOR).
# X_FORWARDED_FOR_PROXY_COUNT=0
# USE_X_FORWARDED_HOST=false

# --- Users and teams ---
# `serve` creates this superuser on start while there are no users yet; ignored once any user exists.
# CREATE_SUPERUSER=admin@example.com:change-me
# One user only: implies SINGLE_TEAM, and nobody registers users or creates teams.
# SINGLE_USER=false
# All projects in one team, created with the first project.
# SINGLE_TEAM=false
# Who may add users / create teams: CB_ANYBODY, CB_MEMBERS, CB_ADMINS or CB_NOBODY.
# USER_REGISTRATION=CB_MEMBERS
# TEAM_CREATION=CB_MEMBERS
# USER_REGISTRATION_VERIFY_EMAIL=true
# Seconds an invitation or password reset link stays valid.
# USER_REGISTRATION_VERIFY_EMAIL_EXPIRY=604800
# Hides the settings page.
# MINIMIZE_INFORMATION_EXPOSURE=false

# --- Email ---
# Without EMAIL_HOST (or with a backend other than Django's SMTP one), emails are only logged.
# Unset: SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Unset by default.
# EMAIL_HOST=smtp.example.org
# EMAIL_HOST_USER=bugsink@example.org
# EMAIL_HOST_PASSWORD=secret
# EMAIL_PORT=587
# Implicit TLS (SMTPS).
# EMAIL_USE_SSL=false
# STARTTLS; unset: true unless EMAIL_USE_SSL.
# EMAIL_USE_TLS=true
# Seconds; unset: no timeout.
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL="Bugsink <bugsink@example.org>"
# "None" for no limit.
# MAX_EMAILS_PER_HOUR=60
# MAX_EMAILS_PER_MONTH=None

# --- Ingest quotas and retention ---
# MAX_EVENTS_PER_PROJECT_PER_5_MINUTES=1000
# MAX_EVENTS_PER_PROJECT_PER_HOUR=5000
# MAX_EVENTS_PER_PROJECT_PER_MONTH=1000000
# MAX_EVENTS_PER_5_MINUTES=1000
# MAX_EVENTS_PER_HOUR=5000
# MAX_EVENTS_PER_MONTH=1000000
# Caps every project's retention; "None" for no cap.
# MAX_RETENTION_PER_PROJECT_EVENT_COUNT=None
# The most all projects' retention settings may add up to; "None" for no cap.
# MAX_RETENTION_EVENT_COUNT=None

# --- Webhook alerts (Slack, Mattermost, Discord, ...) ---
# `open`, or `allowlist_only` to only allow destinations in ALERTS_WEBHOOK_ALLOW_LIST.
# ALERTS_WEBHOOK_OUTBOUND_MODE=open
# Comma-separated hostnames, IPs and CIDR networks.
# ALERTS_WEBHOOK_ALLOW_LIST=
# ALERTS_WEBHOOK_DENY_LIST=
# Refuse destinations that resolve to private, loopback and other non-global addresses.
# ALERTS_WEBHOOK_DENY_NON_GLOBAL=true

# --- Phoning home ---
# Once an hour, send bugsink.com upstream's message about this installation (installation id, upstream version,
# BASE_URL, SITE_TITLE, DEFAULT_FROM_EMAIL, how it's deployed, user/project/team counts; `bugsink print-phonehome`
# shows it) and show superusers the messages it answers with (e.g. security fixes).
# PHONEHOME=true
